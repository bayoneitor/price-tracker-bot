msgid "Pause tracking for a product"
msgstr "Metti in pausa un prodotto"

#: src/price_tracker/bot/commands.py:72
msgid "Resume a paused product"
msgstr "Riattiva un prodotto in pausa"

#: src/price_tracker/bot/commands.py:73
msgid "Delete a tracked product"
msgstr "Elimina un prodotto seguito"

#: src/price_tracker/bot/commands.py:74
msgid "Reset the base price to the current one"
msgstr "Azzera il prezzo base a quello attuale"

#: src/price_tracker/bot/commands.py:75
msgid "Your stats and check interval"
msgstr "Le tue statistiche e l'intervallo di controllo"

#: src/price_tracker/bot/commands.py:76
msgid "Products with recent read errors"
msgstr "Prodotti con errori di lettura recenti"

#: src/price_tracker/bot/commands.py:77
msgid "Show your notification settings"
msgstr "Mostra le tue impostazioni di notifica"

#: src/price_tracker/bot/commands.py:78
msgid "Mute notifications"
msgstr "Silenzia le notifiche"

#: src/price_tracker/bot/commands.py:79
msgid "Unmute notifications"
msgstr "Riattiva le notifiche"

#: src/price_tracker/bot/commands.py:80
msgid "Set quiet hours"
msgstr "Imposta le ore di silenzio"

#: src/price_tracker/bot/commands.py:81
msgid "Set your timezone"
msgstr "Imposta il tuo fuso orario"

#: src/price_tracker/bot/commands.py:82
msgid "Limit how often you are notified"
msgstr "Limita la frequenza delle notifiche"

#: src/price_tracker/bot/commands.py:83
msgid "Switch between instant and digest delivery"
msgstr "Alterna tra notifica immediata e riepilogo"

#: src/price_tracker/bot/commands.py:84
msgid "Send the pending digest now"
msgstr "Invia subito il riepilogo in attesa"

#: src/price_tracker/bot/commands.py:85
msgid "Export your products as CSV"
msgstr "Esporta i tuoi prodotti in CSV"

#: src/price_tracker/bot/commands.py:86
msgid "Import products from a CSV file"
msgstr "Importa prodotti da un file CSV"

#: src/price_tracker/bot/commands.py:87
msgid "Show the menu and available commands"
msgstr "Mostra il menu e i comandi disponibili"

#: src/price_tracker/bot/commands.py:91
msgid "List authorized users"
msgstr "Elenca gli utenti autorizzati"

#: src/price_tracker/bot/commands.py:92
msgid "Authorize a Telegram user"
msgstr "Autorizza un utente Telegram"

#: src/price_tracker/bot/commands.py:93
msgid "Revoke a user's access"
msgstr "Revoca l'accesso a un utente"

#: src/price_tracker/bot/commands.py:94
msgid "Set a nickname for a user"
msgstr "Imposta un soprannome per un utente"

#: src/price_tracker/bot/commands.py:95
msgid "Set the global check interval"
msgstr "Imposta l'intervallo di controllo globale"

#: src/price_tracker/bot/commands.py:96
msgid "Scraper health and quarantine report"
msgstr "Stato degli scraper e quarantene"

#: src/price_tracker/bot/commands.py:97
msgid "Inspect what a scraper reads from a URL"
msgstr "Ispeziona cosa legge uno scraper da un URL"

